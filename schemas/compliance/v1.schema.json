{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data-apis.org/schemas/compliance/v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "api_version", "timestamp", "platform", "python", "test_suite", "data"],
  "properties": {
    "schema": { "const": "v1" },
    "name": { "$ref": "#/$defs/nonempty" },
    "version": { "$ref": "#/$defs/nonempty" },
    "api_version": { "$ref": "#/$defs/nonempty" },
    "timestamp": { "type": "string", "minLength": 20, "maxLength": 40 },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "system", "release", "machine"],
      "properties": {
        "description": { "$ref": "#/$defs/nonemptyLong" },
        "system": { "$ref": "#/$defs/nonempty" },
        "release": { "$ref": "#/$defs/nonempty" },
        "machine": { "$ref": "#/$defs/nonempty" }
      }
    },
    "python": { "$ref": "#/$defs/nonempty" },
    "test_suite": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "exitcode", "summary", "tests"],
      "properties": {
        "duration": { "type": "number", "minimum": 0 },
        "exitcode": { "type": "integer" },
        "summary": {
          "type": "object",
          "required": ["total", "collected"],
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nodeid", "outcome"],
            "properties": {
              "nodeid": { "$ref": "#/$defs/nonemptyLong" },
              "outcome": { "$ref": "#/$defs/nonempty" }
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 512 },
    "nonemptyLong": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
